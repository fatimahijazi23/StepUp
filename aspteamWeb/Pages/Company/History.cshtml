@page
@model aspteamWeb.Pages.Company.HistoryModel
@{
    ViewData["Title"] = "Job History";
    Layout = null;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

<style>
    body {
        background-color: #f7faff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .navbar {
        background-color: #0d6efd;
    }

        .navbar a {
            color: #fff !important;
            font-weight: 500;
        }

    .dashboard-header {
        margin: 40px 0 20px;
        text-align: center;
    }

    .search-box {
        margin: 20px auto;
        max-width: 700px;
    }

    .job-card {
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        transition: transform 0.2s ease-in-out;
        overflow: visible;
    }

        .job-card:hover {
            transform: translateY(-5px);
        }

    #jobsList {
        padding-bottom: 100px;
    }

    .filter-section {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        margin-bottom: 2rem;
    }
</style>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="#">StepUp</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" asp-page="/Company/CompanyDashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Company/ProfileCompany">Profile</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Company/History">History</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Logout">Logout</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- History Header -->
<div class="container">
    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-4 animate__animated animate__fadeIn" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null || !string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-4 animate__animated animate__fadeIn" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @(TempData["ErrorMessage"] ?? Model.ErrorMessage)
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="dashboard-header animate__animated animate__fadeInDown text-center">
        <h1 class="fw-bold text-dark">Job History</h1>
        <a asp-page="/Company/CreateJob" class="btn btn-primary mt-3">
            <i class="bi bi-plus-circle"></i> Create New Job
        </a>
    </div>

    <!-- Search and Filter Section -->
    <div class="filter-section animate__animated animate__fadeIn">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="SearchQuery"
                           value="@Model.SearchQuery"
                           class="form-control"
                           placeholder="Search by title, location...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Status</label>
                <select name="StatusFilter" class="form-select">
                    <option value="">All Jobs</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                    <option value="Closed" selected="@(Model.StatusFilter == "Closed")">Closed</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
            <div class="col-md-2">
                <a href="@Url.Page("/Company/History")" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </form>
    </div>

    <!-- Job Cards -->
    <div class="mt-4" id="jobsList">
        @if (Model.Jobs == null || !Model.Jobs.Any())
        {
            <div class="alert alert-info text-center animate__animated animate__fadeIn">
                <i class="bi bi-briefcase me-2"></i>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <text>No jobs found matching your filters. Try adjusting your search.</text>
                }
                else
                {
                    <text>No job postings yet. Create your first one!</text>
                }
            </div>
        }
        else
        {
            @foreach (var job in Model.Jobs)
            {
                <div class="card job-card mb-4 border-0 animate__animated animate__fadeInUp">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="flex-grow-1">
                                <h5 class="fw-semibold">@job.Title</h5>
                                <p class="text-muted mb-1">
                                    <i class="bi bi-geo-alt"></i> @job.Location •
                                    <i class="bi bi-clock"></i> @job.JobType
                                </p>
                                <div class="mb-2">
                                    <span class="badge bg-info text-white me-1">@job.Industry</span>
                                    <span class="badge bg-secondary me-1">@job.ExperienceLevel</span>
                                    <span class="badge bg-warning text-dark">@job.WorkArrangement</span>
                                </div>
                                <small class="text-muted">
                                    <i class="bi bi-people"></i> @job.ApplicantsCount applicant@(job.ApplicantsCount != 1 ? "s" : "")
                                    &nbsp;|&nbsp;
                                    <i class="bi bi-calendar-event"></i> Posted @job.PostedDaysAgo day@(job.PostedDaysAgo == 1 ? "" : "s") ago
                                </small>
                                @if (job.MinSalaryRange.HasValue && job.MaxSalaryRange.HasValue)
                                {
                                    <div class="mt-2">
                                        <span class="text-success fw-semibold">
                                            <i class="bi bi-currency-dollar"></i>
                                            @job.MinSalaryRange.Value.ToString("N0") - @job.MaxSalaryRange.Value.ToString("N0")
                                        </span>
                                    </div>
                                }
                            </div>
                            <div class="ms-3">
                                @if (job.Status == "Active")
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success px-3 py-2">
                                        <i class="bi bi-check-circle"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-secondary px-3 py-2">
                                        <i class="bi bi-dash-circle"></i> Closed
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-page="/Company/JobDetails" asp-route-id="@job.Id" class="btn btn-primary btn-sm">
                                <i class="bi bi-eye"></i> View Details
                            </a>
                            <a asp-page="/Company/ViewApplicants" asp-route-jobId="@job.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-people"></i> View Applicants (@job.ApplicantsCount)
                            </a>
                            <a asp-page="/Company/EditJob" asp-route-id="@job.Id" class="btn btn-outline-warning btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal@(job.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Delete Confirmation Modal -->
                <div class="modal fade" id="deleteModal@(job.Id)" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">
                                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirm Delete
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p>Are you sure you want to <strong>permanently delete</strong> this job posting?</p>
                                <div class="alert alert-warning">
                                    <strong>@job.Title</strong><br />
                                    <small class="text-muted">@job.Location</small>
                                </div>
                                <p class="text-danger small mb-0">
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                    This action cannot be undone. All applicant data for this job will remain.
                                </p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                </button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@job.Id" class="d-inline">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash me-1"></i>Delete Permanently
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Page("/Company/History", new {
                                   Page = Model.CurrentPage - 1,
                                   SearchQuery = Model.SearchQuery,
                                   StatusFilter = Model.StatusFilter
                               })">
                                <i class="bi bi-chevron-left"></i> Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Page("/Company/History", new {
                                       Page = i,
                                       SearchQuery = Model.SearchQuery,
                                       StatusFilter = Model.StatusFilter
                                   })">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Page("/Company/History", new {
                                   Page = Model.CurrentPage + 1,
                                   SearchQuery = Model.SearchQuery,
                                   StatusFilter = Model.StatusFilter
                               })">
                                Next <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}