@page
@model RegisterModel
@{
    ViewData["Title"] = "Register As Company";
    Layout = null;
} 
 
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: linear-gradient(to right, #007bff, #00c6ff);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .register-container {
        max-width: 500px;
        margin: 70px auto;
        background: #fff;
        padding: 35px;
        border-radius: 15px;
        box-shadow: 0px 8px 25px rgba(0, 0, 0, 0.2);
        animation: fadeInUp 1s ease-in-out;
    }

        .register-container h2 {
            font-weight: bold;
            text-align: center;
            margin-bottom: 10px;
            color: #007bff;
        }

        .register-container p {
            text-align: center;
            color: #666;
            margin-bottom: 25px;
        }

    .btn-custom {
        background: #007bff;
        border: none;
        width: 100%;
        padding: 12px;
        font-size: 16px; 
        border-radius: 8px;
        transition: all 0.3s ease-in-out;
    }

        .btn-custom:hover {
            background: #0056b3;
            transform: scale(1.05);
        }

    .form-control, .form-select {
        border-radius: 8px;
        padding: 12px;
    }

    .login-link {
        text-align: center;
        margin-top: 15px;
    }

        .login-link a {
            color: #007bff;
            text-decoration: none;
        }

            .login-link a:hover {
                text-decoration: underline;
            }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="register-container">
    <h2>Join StepUp</h2>
    <p>Choose your account type to get started</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" type="email" class="form-control" placeholder="Enter your email" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label">Password</label>
            <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.CompanyName" class="form-label">Company Name</label>
            <input asp-for="Input.CompanyName" type="text" class="form-control" placeholder="Enter company name" />
            <span asp-validation-for="Input.CompanyName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Industry" class="form-label">Industry</label>
            <select asp-for="Input.Industry" class="form-control">
                <option value="">Select Industry</option>
                <option value="Technology">Technology</option>
                <option value="Healthcare">Healthcare</option>
                <option value="Finance">Finance</option>
                <option value="Education">Education</option>
                <option value="Manufacturing">Manufacturing</option>
                <option value="Retail">Retail</option>
                <option value="Consulting">Consulting</option>
                <option value="RealEstate">Real Estate</option>
                <option value="Other">Other</option>
            </select>
            <span asp-validation-for="Input.Industry" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.CompanySize" class="form-label">Company Size</label>
            <select asp-for="Input.CompanySize" class="form-select">
                <option value="">Select Size</option>
                <option value="1-10">1-10 employees</option>
                <option value="11-50">11-50 employees</option>
                <option value="51-200">51-200 employees</option>
                <option value="201-500">201-500 employees</option>
                <option value="500+">500+ employees</option>
            </select>
            <span asp-validation-for="Input.CompanySize" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-custom">Create Account</button>
        <div class="login-link">
            Already have an account? <a asp-page="/Company/Login">Login</a>
        </div>
    </form>
</div>
